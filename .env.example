# Copia este fichero a .env y rellena las credenciales.

# Quipu: credenciales de la aplicación OAuth (client credentials)
QUIPU_APP_ID=
QUIPU_APP_SECRET=

# Holded: API key (sección "Desarrolladores" de la configuración de Holded)
HOLDED_API_KEY=

# Opcionales
# FRONTEND_PORT=8080
# BACKEND_PORT=8000
# QUIPU_BASE_URL=https://getquipu.com
# HOLDED_BASE_URL=https://api.holded.com/api
# En Docker, DATABASE_URL ya apunta al volumen: sqlite:////data/quipu_to_holded.db
